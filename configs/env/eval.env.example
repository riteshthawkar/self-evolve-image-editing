PROJECT_ROOT=/absolute/path/to/neurips-project
HF_HOME=/absolute/path/to/cache/huggingface
HUGGINGFACE_HUB_CACHE=/absolute/path/to/cache/huggingface/hub
MODELSCOPE_CACHE=/absolute/path/to/cache/modelscope
TMPDIR=/tmp
OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=
GEDIT_SECRET_ENV_PATH=secret.env
GENEVAL_OBJECT_DETECTOR_ROOT=/absolute/path/to/geneval_detector
# On ROCm Linux, AMD recommends ROCR_VISIBLE_DEVICES.
ROCR_VISIBLE_DEVICES=0
# CUDA_VISIBLE_DEVICES is also accepted by ROCm PyTorch and is portable across vendors.
CUDA_VISIBLE_DEVICES=0
